{
  "name": "text-learning",
  "private": true,
  "version": "1.0.0",
  "description": "Учить текст: тренажёр роли для труппы, пьеса «Райские врата»",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "parse": "tsx tools/parser/cli.ts",
    "scenes:suggest": "tsx tools/parser/suggest-scenes.ts",
    "predev": "npm run parse",
    "dev": "vite",
    "prebuild": "npm run parse",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "tts": "tsx tools/tts/plan.ts --cache .tts-cache && python -m tools.tts --cache .tts-cache && tsx tools/tts/emit.ts --cache .tts-cache --out public/audio",
    "silence": "tsx tools/tts/silence.ts public/silence-1000.mp3",
    "icons": "node tools/icons/generate.mjs",
    "check:size": "node tools/check-size.mjs dist 100",
    "tts:plan": "tsx tools/tts/plan.ts --cache .tts-cache",
    "tts:emit": "tsx tools/tts/emit.ts --cache .tts-cache --out public/audio"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
